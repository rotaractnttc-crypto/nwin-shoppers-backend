# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Use a hosted Postgres for production: Render, Railway, Supabase, or ElephantSQL.
DATABASE_URL=postgres://nwin_user:changeme@localhost:5432/nwin_shoppers
DB_SSL=false

# ---- Auth secrets ----
# Generate strong random values: `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ---- Admin bootstrap (used once by seed script to create the first admin) ----
ADMIN_EMAIL=admin@nwinshoppers.com
ADMIN_PASSWORD=ChangeThisImmediately!2026
ADMIN_NAME=Nwin Admin

# ---- Rate limiting ----
AUTH_RATE_LIMIT_MAX=8
GLOBAL_RATE_LIMIT_MAX=300

# ---- Email (for verification codes) ----
# Easiest free option to test with: a Gmail account + an "App Password"
# (Google Account > Security > 2-Step Verification > App passwords).
# Leave SMTP_HOST blank to skip sending — codes will just print to the
# backend console instead, so you can still test locally without email set up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nwin Shoppers <no-reply@nwinshoppers.com>"

# ---- Google Sign-In ----
# Create a free OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application).
# Add your site's URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# ---- Sign in with Apple ----
# Requires a paid Apple Developer Program account ($99/year) plus a
# registered Services ID and domain association file. Leave blank until
# you're ready to set that up — the endpoint stays disabled until then.
APPLE_CLIENT_ID=

# ---- File uploads (product images) ----
MAX_UPLOAD_MB=5

# ---- Cloudinary (image storage — required for images to survive redeploys) ----
# Free sign-up: https://cloudinary.com/users/register/free
# Dashboard shows all three values right after you create an account.
# Leave these blank to fall back to local disk storage (fine for local dev
# only — images will NOT persist across redeploys on Render without this).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Delivery fee pricing (distance-based, SafeBoda/Bolt-style) ----
# All in UGX. Fee = BASE_FARE + (distance in km * RATE_PER_KM), clamped
# between MIN_FEE and MAX_FEE. FALLBACK_FEE is used when a seller/restaurant
# or the buyer's device hasn't provided GPS coordinates yet.
DELIVERY_BASE_FARE=2000
DELIVERY_RATE_PER_KM=700
DELIVERY_MIN_FEE=2000
DELIVERY_MAX_FEE=25000
DELIVERY_FALLBACK_FEE=5000

# ---- Payments (fill in when you're ready to go live — COD works without these) ----
# Uganda mobile money aggregator, e.g. Flutterwave or Pesapal
PAYMENTS_PROVIDER=none
PAYMENTS_PUBLIC_KEY=
PAYMENTS_SECRET_KEY=
